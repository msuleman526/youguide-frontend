# ---------------------------------------------------------------------------
# youguide-frontend environment template
#
# Copy to .env.local (gitignored) and fill in:
#     cp .env.example .env.local
#
# CRA inlines REACT_APP_* variables at BUILD time — after changing any of these
# you must restart `npm start` / re-run `npm run build`. They are public by
# design (they ship inside the JS bundle), so never put a secret here.
# ---------------------------------------------------------------------------

# Cloudflare Turnstile (captcha on public forms) -----------------------------
# Site key from dash.cloudflare.com -> Turnstile -> your widget. Add
# appadmin.youguide.com (and localhost for dev) to the widget's hostname list.
#
# The matching secret (TURNSTILE_SECRET_KEY) belongs in youguide-backend's .env —
# that is what actually verifies the token. Setting only this one gives you the
# widget with no enforcement.
#
# Leave blank to fall back to Cloudflare's test key, which always passes.
REACT_APP_TURNSTILE_SITE_KEY=
